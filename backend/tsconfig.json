{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noUnusedParameters": true,
    "noEmitOnError": true,
    "useUnknownInCatchVariables": true,
    "skipLibCheck": true,
    "target": "es6",
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
